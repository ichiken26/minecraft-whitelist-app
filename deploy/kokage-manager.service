[Unit]
Description=Kokage Minecraft Admin UI
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/kokage-manager/app
EnvironmentFile=/etc/kokage-manager.env
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/minecraft-container-test/plugins/KokageWhitelist
PrivateTmp=true

[Install]
WantedBy=multi-user.target
